# Copy to .env and fill in. .env is gitignored and loaded automatically by Spring on startup.
DATABASE_URL=jdbc:postgresql://localhost:5433/postgres
DB_USER=postgres
DB_PASSWORD=pg
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# tried in order when the main model answers 503/429 or times out
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
ADMIN_TOKEN=change-me
APP_BASE_URL=http://localhost:8080
STRIPE_SECRET_KEY=
RESEND_API_KEY=
